# --- Bundle de escritorio ----------------------------------------------------
# Pumpscope.app lo genera infrastructure/desktop/construir_app.sh copiando el
# codigo de ps/ y serve.py: es salida de build, no fuente. Se versiona solo el
# icono, que el script lee del bundle para reconstruirlo.
/Pumpscope.app/*
!/Pumpscope.app/Contents/
/Pumpscope.app/Contents/*
!/Pumpscope.app/Contents/Resources/
/Pumpscope.app/Contents/Resources/*
!/Pumpscope.app/Contents/Resources/appicon.icns

# --- SO / editor -------------------------------------------------------------
.DS_Store
.idea/

# --- Corpus del minero -------------------------------------------------------
# Crece hasta miles de archivos y se regenera con infrastructure/scripts/mine_corpus.py.
# Se versionan las fixtures pequenas y curadas de tests/fixtures/*.json, no el corpus.
tests/fixtures/corpus/
