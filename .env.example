# =============================================================================
# Memecoin Intelligence Terminal — plantilla de entorno (SPEC.md 28)
#
# Copia a `.env` y rellena.  NUNCA pongas claves reales en este archivo.
# NUNCA commitees `.env`.  NUNCA pongas aqui una seed phrase: el signer no la usa.
# =============================================================================

# --- Aplicacion --------------------------------------------------------------
APP_ENV=local                      # local | dev | staging | prod
LOG_LEVEL=INFO
LOG_FORMAT=json                    # CLAUDE.md 2: logs estructurados siempre

# --- Persistencia ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://mit:mit@localhost:5432/mit
REDIS_URL=redis://localhost:6379/0

# --- Solana / Helius (requiere credencial) -----------------------------------
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
HELIUS_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
# RPC publico de respaldo. Sin credencial, con rate limit agresivo: solo fallback.
SOLANA_FALLBACK_RPC_URL=https://api.mainnet-beta.solana.com

# --- Mercado -----------------------------------------------------------------
# Jupiter: el plan gratuito no exige key. La key solo sube el rate limit.
JUPITER_API_KEY=
JUPITER_BASE_URL=https://quote-api.jup.ag
DEXSCREENER_BASE_URL=https://api.dexscreener.com

# --- Proveedores opcionales (todos desactivados por defecto) ------------------
BIRDEYE_API_KEY=
BITQUERY_API_KEY=
SOLANATRACKER_API_KEY=
GMGN_API_KEY=
GMGN_BASE_URL=
QUICKNODE_METIS_URL=
PUMPPORTAL_ENABLED=false
RUGCHECK_ENABLED=false
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2

# --- Social y narrativas (requiere credencial) -------------------------------
# X llama "Consumer Key/Secret" a lo mismo que en otras partes de su portal aparece
# como "API Key/Secret": son el MISMO par, no dos credenciales distintas.
# Para leer menciones publicas basta el BEARER TOKEN (autenticacion de app). Las dos
# de abajo solo harian falta para actuar en nombre de un usuario, que no hacemos.
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=
GDELT_ENABLED=false                # GDELT no requiere key
NEWS_RSS_FEEDS=                    # lista separada por comas, sin key

# --- Notificaciones ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_URL=
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=

# =============================================================================
# TRADING REAL — todo lo de abajo esta bloqueado por defecto (SPEC.md 15 y 30)
# =============================================================================
ENABLE_LIVE_TRADING=false          # NO lo pongas en true sin LIVE_TRADING_CHECKLIST.md
LIVE_TRADING_MAX_DAILY_SOL=0.5
LIVE_TRADING_MAX_ORDER_SOL=0.05
LIVE_TRADING_MAX_TOTAL_EXPOSURE_SOL=0.2
LIVE_TRADING_MAX_OPEN_POSITIONS=1
LIVE_TRADING_REQUIRE_PIN=true

# --- Signer aislado (SPEC.md 16) ---------------------------------------------
# El backend principal NUNCA ve la clave. Solo habla con el signer por HTTP local.
SIGNER_MODE=disabled               # disabled | local_encrypted | keychain | hardware | kms
SIGNER_URL=http://signer:8081
SIGNER_SHARED_SECRET=              # HMAC entre ExecutionEngine y signer
ENCRYPTED_KEY_PATH=/run/secrets/trading_key.enc
KEY_ENCRYPTION_PASSWORD_FILE=/run/secrets/key_password
SIGNER_PROGRAM_ALLOWLIST=          # program IDs permitidos, separados por comas
SIGNER_MAX_DAILY_SOL=0.5

# --- Limites de ejecucion (SPEC.md 15) ---------------------------------------
MAX_SLIPPAGE_BPS=250
MAX_PRICE_IMPACT_PERCENT=3.0
MAX_QUOTE_AGE_MS=1500
MAX_PRIORITY_FEE_LAMPORTS=200000
MAX_RETRIES=2
TRANSACTION_TIMEOUT_MS=20000

# --- Limites de riesgo (SPEC.md 14) ------------------------------------------
RISK_PER_TRADE_PERCENT=0.5
MAX_EXPOSURE_PER_TOKEN_PERCENT=3.0
MAX_DAILY_LOSS_PERCENT=3.0
MAX_DRAWDOWN_PERCENT=10.0
MAX_CONSECUTIVE_LOSSES=4
MIN_SOL_FEE_RESERVE=0.02

# --- Observabilidad ----------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_PORT=9090
